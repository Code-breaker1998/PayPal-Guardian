{
  "manifest_version": 3,
  "name": "PayPal Guardian Product Scanner",
  "version": "1.0.0",
  "description": "Automatically detects product data on the current shopping page and sends it to the local PayPal Guardian Agent.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8100/*",
    "http://127.0.0.1:8100/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "PayPal Guardian",
    "default_popup": "popup.html"
  }
}
